{
    "version": 2,
    "builds": [
        {
            "src":"server.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [ 
                    "config/**",
                    "middleware/**",
                    "models/**",
                    "controllers/**",
                    "routers/**",
                    "utilities/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src":"/(.*)",
            "dest": "server.js"
        }
    ]
}